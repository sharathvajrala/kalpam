 "title": {
  "en": "Surya Dwadasa Namavali",
  "te": "సూర్య ద్వాదశ నామావళి"
 },
 "deityIds": [
  "surya"
 ],
 "category": "namavali",
 "parayanamDays": [],
 "source": "The twelve names of Surya Namaskaram (public domain). Complete.",
 "verifiedBy": null,
