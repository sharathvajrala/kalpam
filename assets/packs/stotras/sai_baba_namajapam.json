   "id": "l1",
   "te": "ఓం సాయి శ్రీ సాయి జయ జయ సాయి",
   "translit": "Om Sai Sri Sai Jaya Jaya Sai",
   "meaning": {
    "en": "Om Sai, glorious Sai, victory to Sai",
    "te": "ఓం సాయి, శ్రీ సాయి, జయ జయ సాయి"
   }
  },
  {
   "id": "l2",
   "te": "సద్గురు సాయినాథ మహారాజ్ కీ జై",
   "translit": "Sadguru Sainath Maharaj ki jai",
   "meaning": {
    "en": "Glory to the true Guru, Sainath Maharaj",
    "te": "సద్గురు సాయినాథ మహారాజుకు జయం"
