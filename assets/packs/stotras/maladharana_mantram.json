 "title": {
  "en": "Maladharana Mantram",
  "te": "మాలధారణ మంత్రం"
 },
 "deityIds": [
  "ayyappa"
 ],
 "category": "mantram",
 "parayanamDays": [],
 "source": "Traditional (public domain). Pending pandit verification.",
 "verifiedBy": null,
