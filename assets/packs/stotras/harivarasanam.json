 "title": {
  "en": "Harivarasanam",
  "te": "హరివరాసనం"
 },
 "deityIds": [
  "ayyappa"
 ],
 "category": "keertana",
 "parayanamDays": [],
 "source": "Kumbakudi Kulathur Iyer (1920s, public domain lyric). Recording must be commissioned.",
 "verifiedBy": null,
