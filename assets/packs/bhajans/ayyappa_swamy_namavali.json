  },
  {
   "te": "ఓం మణికంఠాయ నమః",
   "translit": "Om Manikanthaya Namaha"
  },
  {
   "te": "ఓం భూతనాథాయ నమః",
   "translit": "Om Bhutanathaya Namaha"
  },
  {
   "te": "ఓం శబరిగిరీశాయ నమః",
   "translit": "Om Sabarigirishaya Namaha"
  }
