 "lyrics": [
  {
   "te": "శ్రీనివాసా గోవిందా శ్రీ వేంకటేశా గోవిందా",
   "translit": "Srinivasa Govinda Sri Venkatesa Govinda"
  },
  {
   "te": "భక్తవత్సల గోవిందా భాగవతప్రియ గోవిందా",
   "translit": "Bhaktavatsala Govinda Bhagavatapriya Govinda"
  },
  {
   "te": "నిత్యనిర్మల గోవిందా నీలమేఘశ్యామ గోవిందా",
   "translit": "Nityanirmala Govinda Nilameghashyama Govinda"
  },
  {
   "te": "గోవిందా హరి గోవిందా గోకులనందన గోవిందా",
   "translit": "Govinda Hari Govinda Gokulanandana Govinda"
  }
 ]
}
